---
import Base from '@layouts/Base.astro';
import Hero from '@components/Hero.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaBand from '@components/CtaBand.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { photos, alts } from '@data/images';
import { company, leadership, certifications, headlineFacts, milestones as milestoneRegister } from '@data/company';
import { confirmedDepots, stateNames } from '../../lib/facts';

const depots = await confirmedDepots();
const bylands = (await getCollection('depots')).find((d) => d.id === 'bylands' && d.data.confirmed);
const depotStates = depots.map((d) => d.data.state).filter((v, i, a) => a.indexOf(v) === i);
const isoShort = certifications.map((c) => c.standard.split(':')[0]).join(', ');

const listJoin = (arr: string[]) => (arr.length <= 1 ? arr.join('') : `${arr.slice(0, -1).join(', ')} and ${arr[arr.length - 1]}`);
const isoPhrase = `ISO ${listJoin(certifications.map((c) => c.standard.split(':')[0].replace(/^ISO\s*/, '')))}`;
const depotStateNames = listJoin(depotStates.map((s) => stateNames[s] ?? s));

/**
 * Story milestones. Every year and its verification state is read from the milestone register
 * in company.ts; only the prose is written here. A step whose register entry has gone is
 * dropped rather than having its year typed back into the page. An unverified year still
 * renders, qualified with "Date to be confirmed" below.
 */
const fromRegister = (test: RegExp) => milestoneRegister.find((m) => test.test(m.event)) ?? null;
const dated = [
  {
    entry: fromRegister(/began trading/i),
    heading: `Trading begins as ${company.formerName}`,
    body: 'The business starts as a truck-mounted EWP hire company. Most of the early work is for telecommunications contractors who need height and outreach on tower and rooftop sites, with some work for other industries.',
  },
  {
    entry: fromRegister(/rigging and civil works/i),
    heading: 'Comms rigging and civil works',
    body: 'Rigging crews are added so the same company can build and maintain the sites its platforms reach. Civil crews and earthmoving plant follow, covering foundations, trenching, slabs and site access.',
  },
  {
    entry: fromRegister(/workshop/i),
    heading: `Steel fabrication at ${bylands?.data.suburb ?? 'Bylands'}`,
    body: 'A workshop opens on the Northern Highway to fabricate steelwork for our own projects and for clients, from plates and frames to mast structures. Thermal coating and EWP servicing run from the same site.',
  },
];
const milestones: Array<{ when: string; verified: boolean; heading: string; body: string }> = [
  ...dated.flatMap((s) => (s.entry ? [{ when: s.entry.year, verified: s.entry.verified, heading: s.heading, body: s.body }] : [])),
  {
    when: 'Today',
    verified: true,
    heading: 'Three service lines, one management system',
    body: `Comms and rigging, civil works and EWP hire operate under one set of quality, environmental and safety systems certified to ${isoShort}. The trading name changed to ${company.tradingName} to reflect the wider scope.`,
  },
];

/* The stat band states only what the register can evidence: the verified trading year, and
   counts of entries in the certification and depot registers. No headcount, no fleet count. */
const stats = [
  { n: headlineFacts.tradingSince.verified ? headlineFacts.tradingSince.value : null, text: false, l: `Trading since, first as ${company.formerName}` },
  { n: `${certifications.length}`, text: false, l: `Certified management systems: ${isoPhrase}` },
  { n: `${depots.length}`, text: false, l: `Confirmed depots and yards, in ${depotStateNames}` },
  { n: company.descriptor, text: true, l: 'Service lines sharing one set of crews, plant and systems' },
].filter((s) => s.n);

/** The three service lines, each with a photograph from our own sites. The label names the
    part of the site the card leads to, as on the home page. */
const lines = [
  { href: '/services/comms-and-rigging/', label: 'Services', title: 'Comms and rigging', photo: 'riggerOnMonopole' as const,
    text: 'Tower, mast and pole builds, head frame and antenna works, cabling, testing and commissioning for carrier and broadcast sites.' },
  { href: '/services/civil-works/', label: 'Services', title: 'Civil works', photo: 'civilExcavator' as const,
    text: 'Foundations and bored piers, trenching and conduit, equipment slabs, hut installs and site access, with our own excavators and augers.' },
  { href: '/fleet/', label: 'Fleet and hire', title: 'EWP hire', photo: 'truckUnitDepot' as const,
    text: 'Truck-mounted EWPs with published working height, outreach and jacking specs, wet or dry hire, with riggers as operators when you need them.' },
];

/** Trades and roles listed in the capability statement's personnel section. No headcounts. */
const trades = [
  'Advanced riggers', 'Qualified EWP operators', 'Civil plant operators', 'Electricians', 'Electrical spotters',
  'Transmission line workers', 'Scaffolders', 'Telecommunications technicians', 'Diesel mechanics',
  'Project engineers', 'Project managers', 'Warehouse and logistics',
];

const ways = [
  { h: 'Turnaround', p: 'We plan a site so crews, plant and platforms arrive together and the job finishes in one visit where the design allows. Programme dates matter to our clients, so they matter to us.' },
  { h: 'Problem solving', p: 'Most sites turn up something the design pack did not expect. We work the problem on site and put a fix to the client that does not cost excessive time or money.' },
  { h: 'A safe workplace', p: 'One management system covers quality, environment and safety. Every team leader\'s vehicle carries the rescue, monitoring and spill kit listed on our compliance page.' },
  { h: 'Metro and remote', p: 'Crews are set up to work anywhere in Australia, from city rooftops and rail corridors to remote greenfield sites with no mains power.' },
];

const description = `How ${company.tradingName} grew from ${company.formerName}, an EWP hire firm started in ${headlineFacts.tradingSince.value}, into a rigging, civils and EWP contractor under one ISO-certified system.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${company.tradingName}`,
  url: `${company.siteUrl}/about/`,
  description,
  about: { '@id': `${company.siteUrl}/#organization` },
};
---
<Base title="About" description={description} jsonLd={jsonLd}>
  <Hero variant="photo" eyebrow="About" title="A contractor built around telecommunications sites" lead="We started with platforms that could reach a tower. We added the crews that build one and the civils that hold it up. The same people, plant and safety system now cover all three." image={photos.fleetYard} imageAlt={alts.fleetYard}>
    <Breadcrumbs slot="breadcrumbs" items={[{ label: 'About' }]} />
  </Hero>

  <section class="section section--tight section--white">
    <div class="container">
      <ul class="statband reveal" aria-label="Company facts">
        {stats.map((s) => (
          <li>
            <span class:list={["statband__n", { "statband__n--text": s.text }]}>{s.n}</span>
            <span class="statband__l">{s.l}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head section-head--wide reveal">
        <div class="section-head__rule"></div>
        <p class="eyebrow">Our story</p>
        <h2>From travel towers to three service lines</h2>
        <p class="lead">Quantum Comms grew by taking on the work its platforms were being hired for. Each step added a capability the telecommunications programmes we serve kept asking for.</p>
      </div>
      <ol class="timeline reveal" aria-label="Company milestones">
        {milestones.map((m) => (
          <li class="timeline__item">
            <div class="timeline__when">
              <span class:list={["timeline__year", { "timeline__year--word": !/^\d/.test(m.when) }]}>{m.when}</span>
              {!m.verified && <span class="caption timeline__note">Date to be confirmed</span>}
            </div>
            <div class="timeline__what">
              <h3>{m.heading}</h3>
              <p>{m.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--wide reveal">
        <div class="section-head__rule"></div>
        <p class="eyebrow">Today</p>
        <h2>What we run</h2>
        <p class="lead">Three service lines share crews, plant, depots and a single management system, so a client deals with one accountable contractor from permit to handover.</p>
      </div>
      <div class="grid grid--3 reveal">
        {lines.map((l) => (
          <a class="media-card" href={l.href}>
            <div class="media-card__media">
              <Image src={photos[l.photo]} alt={alts[l.photo]} widths={[420, 800]} sizes="(min-width: 900px) 33vw, 100vw" />
            </div>
            <div class="media-card__body">
              <span class="media-card__label">{l.label}</span>
              <h3 class="media-card__title">{l.title}</h3>
              <p>{l.text}</p>
              <span class="arrow-link">Read more</span>
            </div>
          </a>
        ))}
      </div>
      <p class="workshop-note reveal">The workshop at {bylands ? <a href={`/locations/${bylands.id}/`}>{bylands.data.name}</a> : 'Bylands'} supports all three with <a href="/services/steel-fabrication/">steel fabrication</a>, <a href="/services/thermal-coating/">thermal coating</a> and <a href="/services/service-and-maintenance/">EWP service and maintenance</a>.</p>
    </div>
  </section>

  <section class="section section--dark feature">
    <div class="feature__bg" aria-hidden="true">
      <Image src={photos.civilSlabRemote} alt="" widths={[900, 1400, 2000]} sizes="100vw" />
    </div>
    <div class="container feature__inner">
      <div class="feature__text reveal">
        <div class="section-head__rule"></div>
        <p class="eyebrow">How we work</p>
        <h2>Plain expectations, kept</h2>
        <dl class="ways">
          {ways.map((w) => (
            <div class="ways__item">
              <dt>{w.h}</dt>
              <dd>{w.p}</dd>
            </div>
          ))}
        </dl>
        <p class="feature__note">We hire platforms wet or dry, and our EWP operators are trained riggers.</p>
        <a class="arrow-link" href="/fleet/how-hire-works/">How hire works</a>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="split split--wide-text">
        <div class="reveal">
          <div class="section-head colhead">
            <div class="section-head__rule"></div>
            <p class="eyebrow">Leadership</p>
            <h2>Who runs the business</h2>
          </div>
          <div class="people">
            {leadership.map((p) => (
              <div class="card person">
                <h3>{p.name}</h3>
                <p class="person__title">
                  <strong>{p.title}</strong>
                  {!p.verified && <span class="caption"> · title to be confirmed</span>}
                </p>
                <p>Owner and director. Runs the business from the {company.hqAddress.suburb} head office and leads the crews.</p>
              </div>
            ))}
          </div>
          <p class="notice">Profiles for operations, HSEQ and workshop management are to be supplied by Quantum Comms before launch.</p>
        </div>
        <div class="reveal">
          <div class="section-head colhead">
            <div class="section-head__rule"></div>
            <p class="eyebrow">Crews and trades</p>
            <h2>Who does the work</h2>
          </div>
          <p>Rigging crews are based at our depots in {depotStates.join(' and ')}, with civil and road-access crews in {company.hqAddress.state}. Technicians and qualified EWP operators work across both. Crew numbers and headcount are stated in the <a href="/capability-statement/">capability statement</a>.</p>
          <ul class="tags" aria-label="Trades and roles employed">
            {trades.map((t) => <li><span class="chip">{t}</span></li>)}
          </ul>
          <p class="caption">Roles as listed in our capability statement. Training and inductions for every site-based employee are on the <a href="/compliance/">compliance page</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--wide reveal">
        <div class="section-head__rule"></div>
        <p class="eyebrow">Legal identity</p>
        <h2>Who you are contracting with</h2>
        <p class="lead">The details procurement and accounts teams ask for, in one place.</p>
      </div>
      <div class="card legal-panel reveal">
        <dl class="spec legal">
          <dt>Legal name</dt><dd>{company.legalName}</dd>
          <dt>Trading name</dt><dd>{company.tradingName}</dd>
          <dt>Formerly</dt><dd>{company.formerName}</dd>
          <dt>ABN</dt><dd>{company.abn}</dd>
          <dt>ACN</dt><dd>{company.acn}</dd>
          <dt>Trading since</dt><dd>{headlineFacts.tradingSince.value}</dd>
          <dt>Head office</dt><dd>{company.hqAddress.street}, {company.hqAddress.suburb} {company.hqAddress.state} {company.hqAddress.postcode}</dd>
          <dt>Management systems</dt><dd>{certifications.map((c) => `${c.standard} (${c.scope.toLowerCase()})`).join('; ')}. Certificates on the <a href="/compliance/">compliance page</a>.</dd>
          <dt>Contact</dt><dd><a href={`tel:${company.phoneMain.tel}`}>{company.phoneMain.display}</a> · <a href={`mailto:${company.email}`}>{company.email}</a></dd>
        </dl>
        <p class="caption legal-panel__note">Insurance certificates, licences and policies are supplied in the prequalification pack.</p>
        <a class="arrow-link" href="/compliance/">Request the prequalification pack</a>
      </div>
    </div>
  </section>

  <CtaBand heading="Need the company on file?" text="The capability statement carries the same facts as this page, with the fleet register, training matrix and programme list. Prequalification packs are available on request." />
</Base>

<style>
  /* Timeline: the year is the anchor, set in the display width, with a rule per step.
     The last entry is a word rather than a numeral, so it steps down a size. */
  .timeline { list-style: none; margin: 0; padding: 0; max-width: none; display: grid; gap: 0; }
  .timeline__item { display: grid; grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr); gap: clamp(1.25rem, 4vw, 3rem); padding: clamp(1.5rem, 3vw, 2.25rem) 0; border-top: 1px solid var(--concrete); min-width: 0; }
  .timeline__item:first-child { border-top: 2px solid var(--ink); }
  .timeline__item:last-child { border-bottom: 1px solid var(--concrete); }
  .timeline__item > * { min-width: 0; }
  .timeline__when { display: flex; flex-direction: column; gap: 0.35rem; }
  .timeline__year { font-family: var(--font-display); font-weight: 600; font-stretch: var(--wdth-display); font-size: clamp(1.9rem, 1.4rem + 1.9vw, 2.9rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .timeline__year--word { font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.8rem); letter-spacing: -0.02em; }
  .timeline__note { line-height: 1.3; }
  .timeline__what h3 { font-size: var(--fs-h4); margin-bottom: 0.4rem; }
  .timeline__what p { margin: 0; }
  @media (max-width: 560px) { .timeline__item { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; } }

  .workshop-note { margin: clamp(1.75rem, 4vw, 2.5rem) 0 0; }

  /* Feature band: a photograph darkened to carry reversed text, the sector's standard way of
     breaking a long page without adding another card grid. */
  .feature { position: relative; overflow: hidden; }
  .feature__bg { position: absolute; inset: 0; }
  .feature__bg :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .feature__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(92deg, rgba(21,25,28,.95) 0%, rgba(21,25,28,.9) 46%, rgba(21,25,28,.62) 100%); }
  .feature__inner { position: relative; }
  .feature__text { max-width: 60ch; }
  .feature__note { color: var(--on-ink-quiet); font-size: var(--fs-dense); margin-bottom: 0.25rem; }

  .ways { margin: clamp(1.5rem, 3vw, 2.25rem) 0 1.5rem; display: grid; gap: 0; max-width: none; }
  .ways__item { padding: 1rem 0; border-top: 1px solid var(--rule-on-ink); min-width: 0; }
  .ways__item:last-child { border-bottom: 1px solid var(--rule-on-ink); }
  .ways__item dt { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--white); margin-bottom: 0.2rem; }
  .ways__item dd { margin: 0; color: var(--on-ink); max-width: var(--measure); }

  /* Column heads inside a split need less air than a full section head. */
  .colhead { margin-bottom: 1.5rem; gap: 0; }
  .people { display: grid; gap: 1rem; margin-bottom: 1.25rem; }
  .person__title { color: var(--graphite); }
  .tags { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; max-width: none; }
  .tags li { margin: 0; min-width: 0; }
  /* Trade names run to several words, so these chips wrap rather than force the page wide. */
  .tags .chip { white-space: normal; }
  .split > *, .grid > * { min-width: 0; }

  /* The legal identity list stacks below 480 px; its values include long addresses and emails. */
  .legal-panel { max-width: 68ch; gap: 1.25rem; }
  .legal-panel__note { margin: 0; }
  .legal { margin: 0; grid-template-columns: minmax(0, max-content) minmax(0, 1fr); gap: 0.5rem 1.5rem; }
  .legal dt, .legal dd { overflow-wrap: anywhere; }
  .legal dt { font-family: var(--font-display); font-weight: 500; }
  .legal dd { max-width: var(--measure); }
  @media (max-width: 480px) {
    .legal { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .legal dt { margin-top: 0.7rem; }
    .legal dt:first-of-type { margin-top: 0; }
  }
</style>
