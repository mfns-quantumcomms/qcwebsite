---
import Logo from './Logo.astro';
import { footerNav } from '@data/nav';
import { company, certifications, currentYear } from '@data/company';
import { confirmedDepots } from '../lib/facts';
const depots = await confirmedDepots();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a class="brand__logo" href="/" aria-label="Quantum Comms home"><Logo variant="reversed" size="lg" /></a>
        <p class="tag">{company.tagline}</p>
        <address class="addr">
          <span class="addr__label">Head office</span>
          <span class="addr__line">{company.hqAddress.street}, {company.hqAddress.suburb} {company.hqAddress.state} {company.hqAddress.postcode}</span>
          <span class="addr__contact">
            <a href={`tel:${company.phoneMain.tel}`}>{company.phoneMain.display}</a>
            <span class="addr__sep" aria-hidden="true">·</span>
            <a href={`tel:${company.phoneMobile.tel}`}>{company.phoneMobile.display}</a>
          </span>
          <span class="addr__contact"><a href={`mailto:${company.email}`}>{company.email}</a></span>
          <span class="addr__hours">{company.hours}</span>
        </address>
        <div class="social">
          <a href={company.social.linkedin} rel="noopener" target="_blank">LinkedIn</a>
          <a href={company.social.instagram} rel="noopener" target="_blank">Instagram</a>
        </div>
      </div>
      {footerNav.map((col) => (
        <nav class="col" aria-label={col.heading}>
          <h2 class="col__h">{col.heading}</h2>
          <ul>{col.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>

    {depots.length > 0 && (
      <div class="depots">
        <h2 class="col__h">Depots</h2>
        <ul class="depots__list">
          {depots.map((d) => (
            <li>
              <a href={`/locations/${d.id}/`}>
                <span class="depot__place">{d.data.suburb} {d.data.state}</span>
                <span class="depot__role">{d.data.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="bottom">
      <p class="legal">
        © {currentYear} {company.legalName} · ABN {company.abn} · Trading since {company.foundedYear}, formerly {company.formerName}.
      </p>
      <p class="iso">
        {certifications.map((c) => <span class="chip chip--navy">{c.standard.split(':')[0]}</span>)}
        <a href="/compliance/">Certified management systems</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--on-ink); padding: clamp(3rem, 6vw, 5rem) 0 2rem; margin-top: auto; font-size: var(--fs-dense); }
  .site-footer a { color: var(--concrete); text-decoration: none; }
  .site-footer a:hover { color: var(--quantum-green); text-decoration: underline; text-underline-offset: 0.2em; }

  /* Five columns above 1100 px, then two, then one. minmax(0, …) lets a long link wrap
     instead of widening the track. */
  .top { display: grid; grid-template-columns: minmax(0, 1.7fr) repeat(4, minmax(0, 1fr)); gap: clamp(1.75rem, 3vw, 2.75rem); }
  .top > * { min-width: 0; }
  @media (max-width: 1100px) { .top { grid-template-columns: repeat(2, minmax(0, 1fr)); } .brand { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .top { grid-template-columns: minmax(0, 1fr); gap: 2rem; } }

  .brand__logo { display: inline-flex; }
  .brand__logo:hover { text-decoration: none; }
  .tag { color: var(--white); font-family: var(--font-display); font-weight: 500; font-size: var(--fs-lead); line-height: 1.35; letter-spacing: -0.01em; margin: 1.25rem 0 1.5rem; max-width: 26ch; }

  /* The address is a stack of labelled lines, not a paragraph: a procurement reader scans it. */
  .addr { font-style: normal; display: flex; flex-direction: column; overflow-wrap: anywhere; }
  .addr__label { font-family: var(--font-display); font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-ink-quiet); margin-bottom: 0.55rem; }
  .addr__line { color: var(--on-ink); line-height: 1.5; }
  .addr__contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; }
  .addr__contact a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 500; color: var(--white); }
  .addr__sep { color: var(--on-ink-quiet); }
  .addr__hours { color: var(--on-ink-quiet); font-size: var(--fs-caption); margin-top: 0.35rem; }

  .social { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--rule-on-ink); }
  .social a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 500; }

  /* Column headings are labels: quiet, tracked, and separated from their list by a hairline. */
  .col__h { font-family: var(--font-display); font-size: var(--fs-eyebrow); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--on-ink-quiet); margin: 0 0 0.85rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--rule-on-ink); }
  .col ul { list-style: none; margin: 0; padding: 0; max-width: none; }
  .col li { margin: 0; overflow-wrap: break-word; }
  /* Every footer link is a 44 px tap target. */
  .col li a { display: inline-flex; align-items: center; min-height: 44px; line-height: 1.3; }

  /* Depots read as a register: place in white, role beneath it, each row its own target. */
  .depots { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 1.75rem; border-top: 1px solid var(--rule-on-ink); }
  .depots__list { list-style: none; margin: 0; padding: 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 0.25rem clamp(1.5rem, 3vw, 2.5rem); }
  .depots__list li { margin: 0; min-width: 0; }
  /* align-items is set explicitly: the global "a link alone in an li is a target" rule centres
     it, which in a column flex would centre the two lines horizontally. */
  .depots__list a { display: flex; flex-direction: column; align-items: flex-start; gap: 0.15rem; min-height: 44px; justify-content: center; padding: 0.35rem 0; }
  .depots__list a:hover { text-decoration: none; }
  .depot__place { font-family: var(--font-display); font-weight: 600; color: var(--white); }
  .depots__list a:hover .depot__place { color: var(--quantum-green); }
  .depot__role { font-size: var(--fs-caption); color: var(--on-ink-quiet); }

  .bottom { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule-on-ink); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; align-items: center; }
  .legal { margin: 0; min-width: 0; color: var(--on-ink-quiet); font-size: var(--fs-caption); overflow-wrap: break-word; }
  .iso { margin: 0; min-width: 0; display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap; font-size: var(--fs-caption); }
  /* The certification marks are the footer's one green: outlined on Ink, not a filled block. */
  .iso .chip--navy { background: transparent; color: var(--quantum-green); border: 1px solid var(--rule-on-ink); }
  .iso a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
